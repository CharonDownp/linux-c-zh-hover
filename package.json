{
  "name": "zh-linux-api-hover",
  "displayName": "C/C++ 中文标识符速查（Linux）",
  "description": "面向 C/C++ 的中文悬停速查：函数、结构体、类型、宏、成员及变量；AI 按需解释、局部修改与可持久化离线知识库。",
  "version": "1.6.1",
  "publisher": "local-study-tools",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zhLinuxApiHover.searchFunctions",
        "title": "搜索函数、结构体、类型与宏（中文）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.explainFunction",
        "title": "使用 AI 查询函数（可填写补充要求）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.explainIdentifier",
        "title": "使用 AI 解释当前类型、宏或变量（可选提供代码上下文）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.showDetail",
        "title": "查看标识符完整中文解释",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.editExplanation",
        "title": "编辑当前标识符的中文解释（简洁版与详细版）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.refreshFunction",
        "title": "使用 AI 重新解释 / 按要求修改当前标识符",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.saveOffline",
        "title": "将 AI 解释保存到离线知识库",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.manageOffline",
        "title": "管理离线标识符知识库",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.configureApi",
        "title": "配置 AI 接口（地址 / 模型 / API Key）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.checkAiConfig",
        "title": "检查 AI 配置状态（不显示密钥）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.testAiNetwork",
        "title": "测试 AI 接口网络连通性（无需消耗 Token）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.setApiKey",
        "title": "设置 / 更新 API Key（安全存储）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.deleteApiKey",
        "title": "删除已保存的 API Key（需确认）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.testAiAuthentication",
        "title": "测试真实 AI 鉴权（POST，可能消耗少量 Token）",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.clearCache",
        "title": "清空 AI 查询缓存",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.reloadOffline",
        "title": "重新载入离线知识库 JSON",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.exportOffline",
        "title": "导出自定义离线知识库",
        "category": "Linux C 中文速查"
      },
      {
        "command": "zhLinuxApiHover.importOffline",
        "title": "导入自定义离线知识库",
        "category": "Linux C 中文速查"
      }
    ],
    "configuration": {
      "title": "Linux C 中文速查",
      "properties": {
        "zhLinuxApiHover.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容 API 地址，如 https://api.example.com/v1。仅 localhost 可使用 HTTP。不包含密钥。"
        },
        "zhLinuxApiHover.ai.model": {
          "type": "string",
          "default": "",
          "description": "调用的模型 ID，如 gpt-4.1-mini 或服务商提供的模型名。"
        },
        "zhLinuxApiHover.ai.hoverMode": {
          "type": "string",
          "enum": [
            "manual",
            "auto"
          ],
          "default": "manual",
          "enumDescriptions": [
            "仅点击悬停链接或使用命令时调用 API",
            "鼠标悬停未收录的函数时自动请求（可能产生费用）"
          ],
          "description": "默认 manual；自动模式仅对未收录的函数查询，非函数标识符始终需手动发起，以避免无意间上传代码或产生费用。"
        },
        "zhLinuxApiHover.ai.saveMode": {
          "type": "string",
          "enum": [
            "manual",
            "auto",
            "off"
          ],
          "default": "manual",
          "enumDescriptions": [
            "AI 解释先进入缓存，手动确认再存入离线库（推荐）",
            "AI 解释成功后自动保存到永久离线库（可能保存错误内容）",
            "永不自动保存到永久离线库"
          ],
          "description": "将 AI 查询结果升级为自定义永久离线词条的方式。手动操作优先于这个开关。"
        },
        "zhLinuxApiHover.ai.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "将 AI 查询结果保存在本地缓存中，避免重复请求。"
        },
        "zhLinuxApiHover.ai.timeoutMs": {
          "type": "number",
          "default": 90000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "AI 请求等待超时阈值（毫秒）。复杂模型建议 60000-120000；默认 90000。"
        },
        "zhLinuxApiHover.hover.detailMode": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "default": "compact",
          "enumDescriptions": [
            "悬停只显示简洁版，点击链接打开完整说明（推荐）",
            "悬停同时显示简洁版和详细版"
          ],
          "description": "中文悬停说明显示方式。完整资料始终保存在缓存或永久离线库。"
        },
        "zhLinuxApiHover.ai.retryCount": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "AI POST 请求遇临时网络/服务器故障时最多自动重试次数（默认1次）。注意重试可能产生重复计费。"
        },
        "zhLinuxApiHover.ai.proxyUrl": {
          "type": "string",
          "default": "",
          "description": "可选 HTTP/HTTPS 代理地址，例如 http://127.0.0.1:7890，留空则直连（扩展请求不保证继承浏览器代理）。不支持 SOCKS 和代理鉴权。"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "zhLinuxApiHover.explainFunction",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@8"
        },
        {
          "command": "zhLinuxApiHover.explainIdentifier",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@8.5"
        },
        {
          "command": "zhLinuxApiHover.editExplanation",
          "when": "editorLangId == c || editorLangId == cpp",
          "group": "navigation@9"
        }
      ]
    }
  },
  "keywords": [
    "Linux",
    "C",
    "hover",
    "man",
    "中文",
    "API",
    "共享内存",
    "pthread",
    "socket",
    "AI",
    "openai",
    "struct",
    "typedef",
    "variable",
    "macro",
    "sockaddr_in"
  ],
  "license": "MIT"
}
